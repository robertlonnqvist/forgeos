#compdef forgeos

_forgeos() {
    local -a targets
    local -a options

    options=(
        '(-h --help)'{-h,--help}'[Show help message]'
    )

    if command -v forgeos &>/dev/null; then
        targets=($(whence -f | grep '^target_' | sed 's/^target_//'))
    else
        targets=(update clean-system)
    fi

    _arguments \
        '1: :->cmds' \
        '*:: :->args'

    case $state in
        cmds)
            _arguments "$options[@]"
            _values 'targets' "$targets[@]"
        ;;
    esac
}

_forgeos "$@"
