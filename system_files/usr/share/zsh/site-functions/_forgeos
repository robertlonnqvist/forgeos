#compdef forgeos

_forgeos() {
    local -a targets
    local cmd_path

    targets=(
        'update:Upgrade bootc system, Flatpaks, and Homebrew packages'
        'clean-system:Prune Podman resources, clean bootc deployments, Flatpaks, Homebrew'
    )

    # If forgeos exists and has new/custom targets defined, dynamically read them
    cmd_path=$(whence -p forgeos 2>/dev/null)
    if [[ -n "$cmd_path" && -r "$cmd_path" ]]; then
        local -a dynamic_targets
        dynamic_targets=($(sed -nE 's/^target_([a-zA-Z0-9_-]+)\(\).*/\1/p' "$cmd_path"))

        # Use dynamic targets if found, preserving any default descriptions
        if (( ${#dynamic_targets[@]} > 0 )); then
            local t
            local -a custom_list
            for t in "${dynamic_targets[@]}"; do
                case "$t" in
                    update) custom_list+=('update:Upgrade bootc system, Flatpaks, and Homebrew packages') ;;
                    clean-system) custom_list+=('clean-system:Prune Podman resources, clean bootc deployments, Flatpaks, Homebrew') ;;
                    *) custom_list+=("${t}:Custom target") ;;
                esac
            done
            targets=("${custom_list[@]}")
        fi
    fi

    _arguments -s -S \
        '(-h --help)'{-h,--help}'[Show help message]' \
        '1:target:_describe -t targets "forgeos target" targets' \
        '*:: :->args'
}

_forgeos "$@"
