#compdef forgeos

_forgeos() {
    local curcontext="$curcontext" state line ret=1
    typeset -A opt_args

    local -a targets
    targets=(
        'update:Upgrade bootc system, Flatpaks, and Homebrew packages'
        'clean-system:Prune Podman resources, clean bootc deployments, Flatpaks, Homebrew'
    )

    # `_describe` cannot be used directly as an `_arguments` action: `_arguments`
    # would call it with its own compadd options injected (`-M <matcher>`,
    # `-J -default-`, ...), which `_describe` rejects. Use a state instead.
    _arguments -C -s -S \
        '(-h --help)'{-h,--help}'[Show help message]' \
        '(-)1:target:->target' && ret=0

    if [[ "$state" == target ]]; then
        _describe -t targets 'forgeos target' targets && ret=0
    fi

    return ret
}

_forgeos "$@"
