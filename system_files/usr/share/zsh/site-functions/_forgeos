#compdef forgeos

_forgeos() {
    local -A descriptions
    descriptions=(
        update 'Upgrade bootc system, Flatpaks, and Homebrew packages'
        clean-system 'Prune Podman resources, clean bootc deployments, Flatpaks, Homebrew'
    )

    local -aU target_names
    target_names=(update clean-system)

    local cmd_path
    cmd_path=$(whence -p forgeos 2>/dev/null || true)
    if [[ -n "$cmd_path" && -r "$cmd_path" ]]; then
        local -aU dynamic_targets
        dynamic_targets=($(sed -nE 's/^target_([a-zA-Z0-9_-]+)\(\).*/\1/p' "$cmd_path" | awk '!seen[$0]++'))
        if (( ${#dynamic_targets[@]} > 0 )); then
            target_names=("${dynamic_targets[@]}")
        fi
    fi

    local -aU targets
    local t desc
    for t in "${target_names[@]}"; do
        desc="${descriptions[$t]:-Custom target}"
        targets+=("${t}:${desc}")
    done

    _arguments -s -S \
        '(-h --help)'{-h,--help}'[Show help message]' \
        '1:target:_describe "forgeos target" targets' \
        '*:: :->args'
}

_forgeos "$@"