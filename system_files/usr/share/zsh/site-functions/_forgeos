#compdef forgeos

_forgeos() {
    local -a targets
    local -a options

    options=(
        '(-h --help)'{-h,--help}'[Show help message]'
    )

    # Find the forgeos executable path
    local cmd_path=$(whence -p forgeos)
    if [[ -n "$cmd_path" ]]; then
        # Dynamically read target functions directly out of the file
        targets=($(grep -E '^target_[a-zA-Z0-9_-]+\(\)' "$cmd_path" | sed -E 's/^target_([a-zA-Z0-9_-]+)\(\).*/\1/'))
    else
        targets=(update clean-system)
    fi

    _arguments \
        '1: :->cmds' \
        '*:: :->args'

    case $state in
        cmds)
            # Combine options and targets seamlessly
            _arguments "$options[@]"
            _describe -t commands 'forgeos targets' targets
            ;;
    esac
}

_forgeos "$@"
