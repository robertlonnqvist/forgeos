# forgeos completion for Bash

_forgeos_completions() {
    local cur opts cmd_path targets
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"

    # Cache targets globally on the first run so we don't read the disk on every TAB press
    if [[ -z "${_FORGEOS_CACHED_TARGETS+x}" ]]; then
        _FORGEOS_CACHED_TARGETS="update clean-system"
        cmd_path=$(type -P forgeos 2>/dev/null || true)
        if [[ -r "$cmd_path" ]]; then
            targets=$(sed -nE 's/^target_([a-zA-Z0-9_-]+)\(\).*/\1/p' "$cmd_path" | awk '!seen[$0]++')
            if [[ -n "$targets" ]]; then
                _FORGEOS_CACHED_TARGETS="${targets//$'\n'/ }"
            fi
        fi
    fi

    # Only complete on the first argument; subsequent arguments take no parameters
    if [[ ${COMP_CWORD} -gt 1 ]]; then
        return 0
    fi

    # If the user is typing a flag, only suggest flags
    if [[ ${cur} == -* ]]; then
        COMPREPLY=($(compgen -W "-h --help" -- "${cur}"))
        return 0
    fi

    opts="-h --help ${_FORGEOS_CACHED_TARGETS}"
    COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
}

complete -F _forgeos_completions forgeos